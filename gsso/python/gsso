def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="gsso", description="24G AWS SSO profile helper"
    )
    parser.add_argument("--version", action="version", version=f"gsso {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    p_login = sub.add_parser("login", help="renew the 24G SSO session")
    p_login.add_argument(
        "extra",
        nargs="*",
        metavar="...",
        help="passed through to `aws sso login`, e.g. --use-device-code",
    )
    p_login.set_defaults(func=cmd_login)

    p_list = sub.add_parser("list", help="list profiles grouped by account")
    p_list.add_argument(
        "--remote", action="store_true", help="list what the portal reports instead"
    )
    p_list.add_argument(
        "--hard-refresh",
        "--hard",
        action="store_true",
        dest="hard_refresh",
        help="re-query Identity Center and rewrite the portal cache (implies --remote)",
    )
    p_list.set_defaults(func=cmd_list)

    p_add = sub.add_parser("add", help="create managed profiles")
    p_add.add_argument("targets", nargs="*", metavar="ACCOUNT/ROLE")
    p_add.add_argument(
        "--alias",
        metavar="PROFILE",
        help="use this profile name (requires exactly one ACCOUNT/ROLE)",
    )
    p_add.add_argument(
        "--hard-refresh",
        "--hard",
        action="store_true",
        dest="hard_refresh",
        help="re-query Identity Center before adding, instead of using the portal cache",
    )
    p_add.set_defaults(func=cmd_add)

    p_configure = sub.add_parser(
        "configure", help="select the complete set of managed SSO roles"
    )
    p_configure.add_argument(
        "--hard-refresh",
        "--hard",
        action="store_true",
        dest="hard_refresh",
        help="re-query Identity Center before configuring, instead of using the portal cache",
    )
    p_configure.set_defaults(func=cmd_configure)

    p_remove = sub.add_parser("remove", help="delete managed profiles")
    p_remove.add_argument("profiles", nargs="*", metavar="PROFILE")
    p_remove.set_defaults(func=cmd_remove)

    p_mcp = sub.add_parser("mcp", help="manage profiles allowed through AWS MCP")
    mcp_sub = p_mcp.add_subparsers(dest="mcp_action", required=True)
    p_mcp_add = mcp_sub.add_parser(
        "add", help="allow local AWS profiles through AWS MCP"
    )
    p_mcp_add.add_argument("profiles", nargs="*", metavar="PROFILE")
    p_mcp_add.set_defaults(func=cmd_mcp_change)
    p_mcp_remove = mcp_sub.add_parser(
        "remove", help="remove AWS profiles from the MCP allowlist"
    )
    p_mcp_remove.add_argument("profiles", nargs="*", metavar="PROFILE")
    p_mcp_remove.set_defaults(func=cmd_mcp_change)
    p_mcp_default = mcp_sub.add_parser(
        "default", help="set the default AWS MCP profile"
    )
    p_mcp_default.add_argument("profile", nargs="?", metavar="PROFILE")
    p_mcp_default.set_defaults(func=cmd_mcp_default)

    p_whoami = sub.add_parser(
        "whoami", help="show which profile and identity are currently active"
    )
    p_whoami.set_defaults(func=cmd_whoami)

    p_switch = sub.add_parser("switch", help="set AWS_PROFILE for this shell")
    p_switch.add_argument("profile", nargs="?")
    p_switch.add_argument(
        "--set-default", action="store_true", help="also mirror into [default]"
    )
    p_switch.add_argument("--shell", choices=("posix", "powershell"), default="posix")
    p_switch.set_defaults(func=cmd_switch)

    p_init = sub.add_parser(
        "shell-init", help="print the shell wrapper and tab completion for eval"
    )
    p_init.add_argument("shell", choices=("bash", "zsh"))
    p_init.set_defaults(func=cmd_shell_init)

    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "__complete":
        # Bypasses argparse entirely: not a public command, must never fail
        # loudly or touch the network, and must not appear in --help.
        return cmd_complete(argv[1:])
    parser = build_parser()
    if argv and argv[0] == "login" and not {"-h", "--help"} & set(argv):
        # `login` forwards its options to `aws sso login`, so they must not
        # reach argparse, which would reject them as unknown.
        args = parser.parse_args(["login"])
        args.extra = argv[1:]
    else:
        args = parser.parse_args(argv)
    try:
        return args.func(args)
    except GssoError as error:
        err(f"gsso: {error}")
        if error.fix:
            err(f"  fix: {error.fix}")
        return error.code
    except KeyboardInterrupt:
        err("\ngsso: cancelled")
        return EX_FAIL
    except subprocess.CalledProcessError as error:
        err(f"gsso: a command failed: {' '.join(map(str, error.cmd))}")
        return EX_FAIL
    except Exception as error:  # no traceback: a frame could hold the access token
        err(f"gsso: unexpected {type(error).__name__}: {error}")
        if os.environ.get("GSSO_DEBUG"):
            raise
        err("  set GSSO_DEBUG=1 for a traceback")
        return EX_FAIL


if __name__ == "__main__":
    sys.exit(main())
