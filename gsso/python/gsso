class GssoError(Exception):
    """A failure with a known cause. Printed without a traceback."""

    def __init__(self, message: str, code: int = EX_FAIL, fix: Optional[str] = None):
        super().__init__(message)
        self.code = code
        self.fix = fix


def err(*parts: str) -> None:
    """Write to stderr. stdout is reserved for the `switch` export line."""
    print(*parts, file=sys.stderr)


# --------------------------------------------------------------------------
# Config file: a section-preserving reader/writer.
#
# configparser is not used because it drops comments and reformats on write,
# and the managed marker and account name are comments.
# --------------------------------------------------------------------------


class Block:
    def __init__(self, header: Optional[str], lines: List[str]):
        self.header = header  # text inside the brackets, or None for the preamble
        self.lines = lines  # includes the header line itself

    def body(self) -> Iterable[str]:
        return self.lines[1:] if self.header is not None else self.lines

    def has_comment(self, prefix: str) -> bool:
        return any(line.strip().startswith(prefix) for line in self.body())

    def comment_value(self, prefix: str) -> Optional[str]:
        for line in self.body():
            stripped = line.strip()
            if stripped.startswith(prefix):
                return stripped[len(prefix) :].strip()
        return None

    def get(self, key: str) -> Optional[str]:
        for line in self.body():
            stripped = line.strip()
            if stripped.startswith("#") or stripped.startswith(";"):
                continue
            if "=" in stripped:
                name, _, value = stripped.partition("=")
                if name.strip() == key:
                    return value.strip()
        return None

    def insert_comment(self, text: str) -> bool:
        """Add a comment directly under the header. True if the file changed."""
        if self.header is None or self.has_comment(text.split(":")[0] + ":"):
            return False
        self.lines.insert(1, text + "\n")
        return True


class ConfigFile:
    def __init__(self, path: Path):
        self.path = path
        self.blocks: List[Block] = []
        if not path.exists():
            return
        current = Block(None, [])
        self.blocks.append(current)
        for line in path.read_text().splitlines(keepends=True):
            match = SECTION_RE.match(line)
            if match:
                current = Block(match.group(1).strip(), [line])
                self.blocks.append(current)
            else:
                current.lines.append(line)

    def sections(self) -> List[Block]:
        return [b for b in self.blocks if b.header is not None]

    def section(self, header: str) -> Optional[Block]:
        for block in self.sections():
            if block.header == header:
                return block
        return None

    def append_section(self, lines: Sequence[str]) -> Block:
        """Append a rendered section, keeping a blank line before it."""
        if self.blocks:
            previous = self.blocks[-1]
            if previous.lines and previous.lines[-1].strip() != "":
                previous.lines.append("\n")
        match = SECTION_RE.match(lines[0])
        if match is None:
            raise GssoError(f"not a section header: {lines[0]!r}")
        block = Block(match.group(1).strip(), list(lines))
        self.blocks.append(block)
        return block

    def remove_section(self, header: str) -> bool:
        for i, block in enumerate(self.blocks):
            if block.header == header:
                del self.blocks[i]
                return True
        return False

    def render(self) -> str:
        return "".join(line for block in self.blocks for line in block.lines)

    def save(self) -> None:
        atomic_write(self.path, self.render())


def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o600
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".gsso-")
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


