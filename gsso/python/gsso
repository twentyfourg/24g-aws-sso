def cmd_mcp_change(args: argparse.Namespace) -> int:
    configs = discover_mcp_configs()
    if not configs:
        raise GssoError(
            "no configured aws-mcp server found",
            fix="run the AWS MCP setup workflow first",
        )
    current = current_mcp_profiles(configs)
    known = completion_switch_targets()

    if args.mcp_action == "add":
        if args.profiles:
            default = None
            targets = []
            for profile in args.profiles:
                validate_mcp_profile_name(profile)
                if profile not in known:
                    raise GssoError(
                        f"no such local AWS profile: {profile}",
                        fix="run `gsso list` to see configured profiles",
                    )
                if profile in current:
                    err(f"already allowed: {profile}")
                elif profile not in targets:
                    targets.append(profile)
            updated = with_default_first(current + targets, default)
        else:
            # The menu edits the whole allowlist: it lists every local profile
            # with the allowed ones checked, so unchecking one removes it.
            options = sorted(set(known) | set(current))
            if not options:
                raise GssoError(
                    "no local AWS profiles found",
                    fix="run `gsso add` to create profiles first",
                )
            targets, default = choose(
                options,
                "Allow which profiles in AWS MCP (checked = allowed now)",
                multiple=True,
                allow_default=True,
                preselected=current,
                default_option=current[0] if current else None,
            )
            if not default and current and current[0] in targets:
                default = current[0]
            kept = [profile for profile in current if profile in targets]
            added = [profile for profile in targets if profile not in current]
            updated = with_default_first(kept + added, default)
    else:
        if not current:
            raise GssoError(
                "the AWS MCP profile allowlist is empty",
                fix="use `gsso mcp add` first",
            )
        if args.profiles:
            targets = []
            for profile in args.profiles:
                validate_mcp_profile_name(profile)
                if profile not in current:
                    err(f"not currently allowed: {profile}")
                elif profile not in targets:
                    targets.append(profile)
        else:
            targets, _ = choose(
                current, "Remove which profiles from AWS MCP", multiple=True
            )
        updated = [profile for profile in current if profile not in targets]
        if not updated:
            raise GssoError(
                "refusing to remove every AWS MCP profile",
                fix="keep one default profile, or disable aws-mcp in each agent",
            )

    return save_mcp_profiles(configs, updated)


def cmd_mcp_default(args: argparse.Namespace) -> int:
    configs = discover_mcp_configs()
    if not configs:
        raise GssoError(
            "no configured aws-mcp server found",
            fix="run the AWS MCP setup workflow first",
        )
    current = current_mcp_profiles(configs)
    if not current:
        raise GssoError(
            "the AWS MCP profile allowlist is empty",
            fix="use `gsso mcp add` first",
        )
    if args.profile:
        validate_mcp_profile_name(args.profile)
        target = args.profile
    elif supports_checkbox_menu():
        target = choose_one(current, "Default AWS MCP profile", initial=0)
    else:
        names, _ = choose(current, "Default AWS MCP profile", multiple=False)
        target = names[0]
    updated = with_default_first(current, target)
    return save_mcp_profiles(configs, updated)


def save_mcp_profiles(configs: Sequence[McpConfig], updated: Sequence[str]) -> int:
    if all(list(config.profiles) == list(updated) for config in configs):
        if updated:
            err(f"AWS MCP default profile: {updated[0]}")
            err(f"AWS MCP allowed profiles: {' '.join(updated)}")
        return EX_OK
    backup = create_mcp_rollback_point([config.path for config in configs])
    err(f"Rollback point: {backup}")
    for config in configs:
        write_mcp_profiles(config, updated)
        err(f"updated {config.agent}: {config.path}")
    err(f"AWS MCP default profile: {updated[0]}")
    err(f"AWS MCP allowed profiles: {' '.join(updated)}")
    err("Restart the configured agents to reload AWS MCP.")
    return EX_OK


def cmd_login(args: argparse.Namespace) -> int:
    """Renew the SSO session. Nothing more.

    This deliberately does not touch profiles. Discovering newly granted roles
    is `gsso list --remote`; creating profiles for them is `gsso add`.
    """
    require_aws()
    command = ["aws", "sso", "login", "--sso-session", SESSION_NAME, *args.extra]
    return subprocess.run(command).returncode


def cmd_list(args: argparse.Namespace) -> int:
    require_aws()
    if args.remote or args.hard_refresh:
        return list_remote(args.hard_refresh)
    return list_local()


def list_local() -> int:
    config_profiles = read_config_profiles()
    credential_names = set(read_credentials_profile_names()) - {"default"}
    current = os.environ.get("AWS_PROFILE")

    managed = [p for p in config_profiles if p.managed]
    unmanaged = [
        p.name for p in config_profiles if not p.managed and p.name not in credential_names
    ]

    groups: Dict[Tuple[str, str], List[Profile]] = {}
    for profile in managed:
        key = (profile.account_name or "(unknown account)", profile.account_id or "?")
        groups.setdefault(key, []).append(profile)

    if not groups and not credential_names and not unmanaged:
        err("No profiles configured. Run `gsso login`.")
        return EX_OK

    width = max([len(p.name) for p in managed] + [10])
    for (account_name, account_id) in sorted(groups):
        print(f"{account_name} ({account_id})")
        for profile in sorted(groups[(account_name, account_id)], key=lambda p: p.name):
            mark = ">" if profile.name == current else " "
            print(f"  {mark} {profile.name:<{width}}  {profile.role_name or ''}")
        print()

    if credential_names:
        print(f"Static credential profiles ({CREDENTIALS_PATH})")
        for name in sorted(credential_names):
            mark = ">" if name == current else " "
            print(f"  {mark} {name}")
        print()

    if unmanaged:
        print(f"Unmanaged profiles ({CONFIG_PATH})")
        for name in sorted(unmanaged):
            mark = ">" if name == current else " "
            print(f"  {mark} {name}")
        print()
    return EX_OK


def list_remote(hard_refresh: bool) -> int:
    pairs = load_remote_pairs(hard_refresh)
    configured = {(p.account_id, p.role_name) for p in read_config_profiles()}
    by_account: Dict[Tuple[str, str], List[str]] = {}
    for account_id, account_name, role_name in pairs:
        by_account.setdefault((account_name, account_id), []).append(role_name)
    for (account_name, account_id) in sorted(by_account):
        print(f"{account_name} ({account_id})")
        for role in sorted(by_account[(account_name, account_id)]):
            state = "configured" if (account_id, role) in configured else "not configured"
            print(f"    {role:<34}  {state}")
        print()
    return EX_OK


def cmd_add(args: argparse.Namespace) -> int:
    require_aws()
    if args.alias and len(args.targets) != 1:
        raise GssoError(
            "--alias requires exactly one ACCOUNT/ROLE target",
            fix="run `gsso add --alias PROFILE ACCOUNT/ROLE`",
        )
    if args.alias:
        validate_profile_name(args.alias)
    pairs = load_remote_pairs(args.hard_refresh)
    shared = shared_role_names(pairs)
    existing = {p.name for p in read_config_profiles()}
    configured = {(p.account_id, p.role_name) for p in read_config_profiles()}

    candidates = {
        f"{name}/{role}": (account_id, name, role)
        for account_id, name, role in pairs
        if (account_id, role) not in configured
    }
    if not candidates:
        err("Every available role already has a profile.")
        return EX_OK

    if args.targets:
        selected = []
        for target in args.targets:
            if target not in candidates:
                raise GssoError(
                    f"not an available, unconfigured role: {target}",
                    fix="run `gsso list --remote` to see valid values",
                )
            selected.append(candidates[target])
    else:
        picked, _ = choose(sorted(candidates), "Add which roles", multiple=True)
        selected = [candidates[p] for p in picked]

    if args.alias and args.alias in existing:
        raise GssoError(f"profile already exists: {args.alias}")

    planned = []
    for account_id, account_name, role_name in selected:
        name = args.alias or proposed_name(account_name, role_name, shared)
        if name in existing:
            err(f"skipped {name}: a profile with that name already exists")
            continue
        planned.append((name, account_id, account_name, role_name))
        existing.add(name)
    if not planned:
        return EX_OK

    backup = create_rollback_point()
    err(f"Rollback point: {backup}")
    write_profiles(planned, default_region())
    for name, _account_id, _account_name, _role_name in planned:
        err(f"added {name}")
    return EX_OK


def cmd_configure(args: argparse.Namespace) -> int:
    """Edit the complete set of managed SSO roles in one checkbox menu."""
    require_aws()
    remote_pairs = load_remote_pairs(args.hard_refresh)
    profiles = read_config_profiles()
    configured = {
        (profile.account_id, profile.role_name)
        for profile in profiles
        if profile.account_id and profile.role_name
    }
    managed_by_pair = {
        (profile.account_id, profile.role_name): profile
        for profile in profiles
        if profile.managed and profile.account_id and profile.role_name
    }
    remote_by_pair = {
        (account_id, role_name): (account_name, role_name)
        for account_id, account_name, role_name in remote_pairs
    }

    choices: Dict[str, Tuple[str, str]] = {}
    preselected = []
    for pair in sorted(set(remote_by_pair) | set(managed_by_pair)):
        account_id, role_name = pair
        if pair in remote_by_pair:
            account_name = remote_by_pair[pair][0]
            label = f"{account_name} ({account_id})/{role_name}"
        else:
            profile = managed_by_pair[pair]
            account_name = profile.account_name or account_id
            label = (
                f"{account_name} ({account_id})/{role_name} "
                "(not currently available)"
            )
        choices[label] = pair
        if pair in configured:
            preselected.append(label)

    if not choices:
        err("No available or configured SSO roles found.")
        return EX_OK

    picked, _ = choose(
        sorted(choices),
        "Configure SSO roles (checked = configured now)",
        multiple=True,
        preselected=preselected,
    )
    selected = {choices[label] for label in picked}
    additions = [
        (account_id, account_name, role_name)
        for account_id, account_name, role_name in remote_pairs
        if (account_id, role_name) in selected
        and (account_id, role_name) not in configured
    ]
    doomed = [
        profile
        for pair, profile in managed_by_pair.items()
        if pair not in selected
    ]
    if not additions and not doomed:
        err("SSO role configuration is already up to date.")
        return EX_OK

    shared = shared_role_names(remote_pairs)
    removed_names = {profile.name for profile in doomed}
    occupied = {profile.name for profile in profiles if profile.name not in removed_names}
    planned_additions = []
    for account_id, account_name, role_name in additions:
        default = proposed_name(account_name, role_name, shared)
        name = prompt_profile_name(
            f"{account_name}/{role_name}",
            default,
            occupied.copy(),
        )
        occupied.add(name)
        planned_additions.append(
            (name, account_id, account_name, role_name)
        )

    backup = create_rollback_point()
    err(f"Rollback point: {backup}")

    if doomed:
        config = ConfigFile(CONFIG_PATH)
        default_block = config.section("default")
        default_account = default_block.get("sso_account_id") if default_block else None
        current = os.environ.get("AWS_PROFILE")
        for profile in doomed:
            config.remove_section(f"profile {profile.name}")
            err(f"removed {profile.name}")
            if profile.name == current:
                err(f"  note: AWS_PROFILE still points at {profile.name} in this shell")
            if default_account and profile.account_id == default_account:
                err(
                    "  note: [default] mirrors this profile and now references "
                    "a removed role"
                )
        config.save()

    write_profiles(planned_additions, default_region())
    for name, _account_id, _account_name, _role_name in planned_additions:
        err(f"added {name}")
    return EX_OK


def cmd_remove(args: argparse.Namespace) -> int:
    require_aws()
    profiles = {p.name: p for p in read_config_profiles()}
    managed = sorted(name for name, p in profiles.items() if p.managed)

    if args.profiles:
        targets = args.profiles
    else:
        if not managed:
            err("No managed profiles to remove.")
            return EX_OK
        targets, _ = choose(managed, "Remove which profiles", multiple=True)

    doomed = []
    for name in targets:
        profile = profiles.get(name)
        if profile is None:
            err(f"skipped {name}: no such profile in {CONFIG_PATH}")
        elif not profile.managed:
            err(f"skipped {name}: not managed by this tool, so it will not be touched")
        else:
            doomed.append(name)
    if not doomed:
        return EX_FAIL

    backup = create_rollback_point()
    err(f"Rollback point: {backup}")
    config = ConfigFile(CONFIG_PATH)
    default_block = config.section("default")
    default_account = default_block.get("sso_account_id") if default_block else None
    current = os.environ.get("AWS_PROFILE")

    for name in doomed:
        config.remove_section(f"profile {name}")
        err(f"removed {name}")
        if name == current:
            err(f"  note: AWS_PROFILE still points at {name} in this shell")
        if default_account and profiles[name].account_id == default_account:
            err("  note: [default] mirrors this profile and now references a removed role")
    config.save()
    return EX_OK


def cmd_switch(args: argparse.Namespace) -> int:
    require_aws()
    known = [p.name for p in read_config_profiles()] + read_credentials_profile_names()
    known = sorted({n for n in known if n != "default"})
    if not known:
        raise GssoError("no profiles configured", fix="run `gsso login`")

    if args.profile:
        if args.profile not in known:
            raise GssoError(
                f"no such profile: {args.profile}", fix="run `gsso list`"
            )
        target = args.profile
    else:
        names, _ = choose(known, "Switch to which profile", multiple=False)
        target = names[0]

    if args.set_default:
        set_default_profile(target)

    if args.shell == "powershell":
        print(f"$env:AWS_PROFILE = '{target}'")
    else:
        print(f"export AWS_PROFILE={target}")
    err(f"AWS_PROFILE={target}")
    return EX_OK


def set_default_profile(name: str) -> None:
    if "default" in read_credentials_profile_names():
        err("")
        err(f"{CREDENTIALS_PATH} has its own [default] section with static keys.")
        err("Writing an SSO default into ~/.aws/config changes how plain `aws` behaves:")
        err("it will attempt SSO and fail when no token exists, instead of falling back")
        err("to those static keys. Anything relying on them will break once the session")
        err("expires.")
        if not confirm("Write the SSO default anyway?"):
            raise GssoError("left [default] alone")

    source = ConfigFile(CONFIG_PATH).section(f"profile {name}")
    if source is None:
        raise GssoError(f"{name} is not an SSO profile in {CONFIG_PATH}")
    backup = create_rollback_point()
    err(f"Rollback point: {backup}")
    for key in ("sso_session", "sso_account_id", "sso_role_name", "region"):
        value = source.get(key)
        if value:
            aws_configure_set(f"default.{key}", value)
    err(f"[default] now mirrors {name}")


def find_account_name(account_id: Optional[str]) -> Optional[str]:
    """Best-effort account name for an id with no # account-name: of its own."""
    if not account_id:
        return None
    for profile in read_config_profiles():
        if profile.account_id == account_id and profile.account_name:
            return profile.account_name
    return None


def cmd_whoami(args: argparse.Namespace) -> int:
    """Show which profile is active and what identity it actually resolves to.

    This calls `aws sts get-caller-identity`, not just AWS_PROFILE, so it
    confirms the credentials really work rather than only that a `switch`
    export happened. That distinction matters: `switch` succeeding only
    proves the shell variable was set, not that the session behind it is
    still valid.
    """
    require_aws()
    profile_env = os.environ.get("AWS_PROFILE")
    aws_args = ["sts", "get-caller-identity"]
    if profile_env:
        aws_args += ["--profile", profile_env]

    try:
        identity = json.loads(run_aws(aws_args))
    except GssoError as error:
        lowered = str(error).lower()
        if "sso token" in lowered or "sso session" in lowered:
            raise GssoError(str(error), EX_AUTH, "run `gsso login`") from error
        if "could not be found" in lowered and "profile" in lowered:
            raise GssoError(
                str(error), EX_FAIL, "run `gsso list` to see valid profile names"
            ) from error
        raise

    account_id = identity.get("Account", "")
    arn = identity.get("Arn", "")
    user_id = identity.get("UserId", "")

    if profile_env:
        label = f"{profile_env}  (from AWS_PROFILE)"
        block = ConfigFile(CONFIG_PATH).section(f"profile {profile_env}")
    else:
        label = "[default]  (AWS_PROFILE is not set in this shell)"
        block = ConfigFile(CONFIG_PATH).section("default")

    role_name = block.get("sso_role_name") if block else None
    account_name = (
        block.comment_value(ACCOUNT_NAME_KEY) if block else None
    ) or find_account_name(account_id)

    print(f"Profile:  {label}")
    print(f"Account:  {account_name + ' ' if account_name else ''}({account_id})")
    if role_name:
        print(f"Role:     {role_name}")
    elif not account_name:
        print("Note:     not a profile gsso manages; showing raw AWS identity only")
    print(f"ARN:      {arn}")
    print(f"User ID:  {user_id}")
    return EX_OK


SHELL_FUNCTION = """\
gsso() {
  case "$1" in
    switch)
      shift
      __gsso_out="$(command gsso switch --shell posix "$@")" || return $?
      if [ -n "$__gsso_out" ]; then
        eval "$__gsso_out"
      fi
      unset __gsso_out
      ;;
    *)
      command gsso "$@"
      ;;
  esac
}

_gsso_complete() {
  local cur words cword candidates
  cur="${COMP_WORDS[COMP_CWORD]}"
  words=("${COMP_WORDS[@]:1}")
  cword=$((COMP_CWORD - 1))
  candidates="$(command gsso __complete "$cword" "${words[@]}" 2>/dev/null)"
  COMPREPLY=($(compgen -W "$candidates" -- "$cur"))
}
complete -F _gsso_complete gsso
"""

# zsh has no native bash-style `complete`/COMP_WORDS. bashcompinit provides a
# compatibility shim so the exact same completion function works unchanged,
# but bashcompinit's `complete` itself calls `compdef`, which only exists
# once zsh's own completion system has been initialized. Most interactive
# zsh setups already call `compinit` (directly, or via a framework), but it
# is not guaranteed, so it is initialized here too if missing. Calling it a
# second time is harmless; zsh reuses its cached dump file.
ZSH_COMPLETION_PREAMBLE = """\
if ! whence compdef >/dev/null 2>&1; then
  autoload -Uz compinit
  compinit
fi
autoload -Uz bashcompinit
bashcompinit
"""


def cmd_shell_init(args: argparse.Namespace) -> int:
    if args.shell not in ("bash", "zsh"):
        raise GssoError(f"unsupported shell: {args.shell}")
    body = SHELL_FUNCTION
    if args.shell == "zsh":
        body = ZSH_COMPLETION_PREAMBLE + body
    print(body, end="")
    return EX_OK


# --------------------------------------------------------------------------
# Shell completion
#
# `gsso __complete <cword> [word ...]` is a hidden subcommand invoked by the
# shell function above on every TAB press. It must never make a network call
# or block: candidates come only from local files (config, credentials, the
# portal cache), and any error is swallowed so a bad TAB never breaks typing.
# --------------------------------------------------------------------------

SUBCOMMANDS = [
    "login",
    "list",
    "add",
    "configure",
    "remove",
    "mcp",
    "switch",
    "whoami",
    "shell-init",
]
LOGIN_FLAGS = ["--use-device-code", "--no-browser"]
LIST_FLAGS = ["--remote", "--hard-refresh", "--hard"]
ADD_FLAGS = ["--alias", "--hard-refresh", "--hard"]
CONFIGURE_FLAGS = ["--hard-refresh", "--hard"]
SWITCH_FLAGS = ["--set-default", "--shell"]


def completion_switch_targets() -> List[str]:
    try:
        names = [p.name for p in read_config_profiles()] + read_credentials_profile_names()
        return sorted({n for n in names if n != "default"})
    except Exception:
        return []


def completion_managed_profiles() -> List[str]:
    try:
        return sorted(p.name for p in read_config_profiles() if p.managed)
    except Exception:
        return []


def completion_add_targets() -> List[str]:
    """Unconfigured account/role pairs from the portal cache. Never queries live."""
    try:
        cached = read_portal_cache()
        if cached is None:
            return []
        _fetched, pairs = cached
        configured = {(p.account_id, p.role_name) for p in read_config_profiles()}
        return sorted(
            f"{name}/{role}"
            for account_id, name, role in pairs
            if (account_id, role) not in configured
        )
    except Exception:
        return []


def complete_candidates(words: List[str], cword: int) -> List[str]:
    if cword == 0:
        return SUBCOMMANDS

    sub = words[0] if words else ""
    already = set(words[1:cword])

    if sub == "switch":
        prev = words[cword - 1] if cword >= 1 else ""
        if prev == "--shell":
            return ["posix", "powershell"]
        if cword == 1:
            return completion_switch_targets() + SWITCH_FLAGS
        return SWITCH_FLAGS

    if sub == "remove":
        return [p for p in completion_managed_profiles() if p not in already]

    if sub == "add":
        return [c for c in completion_add_targets() if c not in already] + ADD_FLAGS

    if sub == "configure":
        return CONFIGURE_FLAGS

    if sub == "mcp":
        if cword == 1:
            return ["add", "remove", "default"]
        action = words[1] if len(words) > 1 else ""
        selected = set(words[2:cword])
        if action == "add":
            try:
                configs = discover_mcp_configs()
                allowed = set(current_mcp_profiles(configs, announce=False))
                return [
                    name
                    for name in completion_switch_targets()
                    if name not in allowed and name not in selected
                ]
            except Exception:
                return []
        if action == "remove":
            try:
                configs = discover_mcp_configs()
                return [
                    name
                    for name in current_mcp_profiles(configs, announce=False)
                    if name not in selected
                ]
            except Exception:
                return []
        if action == "default":
            try:
                configs = discover_mcp_configs()
                return current_mcp_profiles(configs, announce=False)
            except Exception:
                return []
        return []

    if sub == "list":
        return LIST_FLAGS

    if sub == "shell-init":
        return ["bash", "zsh"] if cword == 1 else []

    if sub == "login":
        return LOGIN_FLAGS

    return []


def cmd_complete(raw_args: Sequence[str]) -> int:
    if not raw_args:
        return EX_OK
    try:
        cword = int(raw_args[0])
    except ValueError:
        return EX_OK
    words = list(raw_args[1:])
    try:
        candidates = complete_candidates(words, cword)
    except Exception:
        candidates = []
    for candidate in candidates:
        print(candidate)
    return EX_OK


