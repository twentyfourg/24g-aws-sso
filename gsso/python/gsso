# SSO token
# --------------------------------------------------------------------------


def parse_timestamp(raw: str) -> Optional[datetime]:
    """Parse the three expiresAt shapes the CLI has written over time."""
    match = TIMESTAMP_RE.match(raw.strip())
    if not match:
        return None
    year, month, day, hour, minute, second, fraction, offset = match.groups()
    micro = int((fraction or "0").ljust(6, "0")[:6])
    if offset in (None, "Z", "UTC"):
        tz = timezone.utc
    else:
        tz = datetime.strptime(offset.replace(":", ""), "%z").tzinfo
    return datetime(
        int(year), int(month), int(day), int(hour), int(minute), int(second), micro, tz
    )


def load_access_token() -> str:
    """Return the newest unexpired 24G token. Never log or print the value."""
    if not SSO_CACHE_DIR.is_dir():
        raise GssoError("no SSO cache directory", EX_AUTH, "run `gsso login`")
    best: Optional[Tuple[datetime, str]] = None
    now = datetime.now(timezone.utc)
    for path in SSO_CACHE_DIR.glob("*.json"):
        try:
            data = json.loads(path.read_text())
        except (ValueError, OSError):
            continue  # client registration files and partial writes
        if not isinstance(data, dict):
            continue
        token = data.get("accessToken")
        if not token or data.get("startUrl") != SSO_START_URL:
            continue
        expires = parse_timestamp(str(data.get("expiresAt", "")))
        if expires is None or expires <= now:
            continue
        if best is None or expires > best[0]:
            best = (expires, token)
    if best is None:
        raise GssoError(
            "no valid 24G SSO session", EX_AUTH, "run `gsso login`"
        )
    return best[1]


