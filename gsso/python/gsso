def require_aws() -> None:
    if shutil.which("aws") is None:
        raise GssoError(
            "the AWS CLI is not on PATH",
            EX_DEP,
            "install AWS CLI v2, then re-run",
        )
    out = subprocess.run(
        ["aws", "--version"], capture_output=True, text=True
    ).stdout.strip()
    if not out.startswith("aws-cli/2"):
        raise GssoError(
            f"AWS CLI v2 is required, found: {out or 'unknown'}",
            EX_DEP,
            "sso-session configuration needs v2; upgrade and re-run",
        )


def run_aws(args: Sequence[str], secret: Optional[str] = None) -> str:
    """Run an aws subcommand and return stdout.

    `secret` is redacted from any error text before it is raised, because the
    SSO access token is passed to some commands as an argument and would
    otherwise reach the user through the failure message.
    """
    proc = subprocess.run(
        ["aws", *args, "--no-cli-pager"], capture_output=True, text=True
    )
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        if secret:
            detail = detail.replace(secret, "<redacted>")
        raise GssoError(f"aws {' '.join(redact_args(args, secret))} failed: {detail}")
    return proc.stdout


def redact_args(args: Sequence[str], secret: Optional[str]) -> List[str]:
    if not secret:
        return list(args)
    return ["<redacted>" if a == secret else a for a in args]


def aws_configure_set(key: str, value: str) -> None:
    subprocess.run(["aws", "configure", "set", key, value], check=True)


