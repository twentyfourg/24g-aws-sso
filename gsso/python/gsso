def create_rollback_point() -> Path:
    """Copy the files this script may change. Same format as 24GAWSSOSetup.md."""
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    backup_dir = BACKUP_ROOT / stamp
    backup_dir.mkdir(parents=True, exist_ok=True)
    manifest = []
    if CONFIG_PATH.exists():
        shutil.copy2(CONFIG_PATH, backup_dir / "config")
        manifest.append(f"config\t{CONFIG_PATH}")
    else:
        manifest.append(f"ABSENT\t{CONFIG_PATH}")
    (backup_dir / "manifest.tsv").write_text("\n".join(manifest) + "\n")
    return backup_dir


def create_mcp_rollback_point(paths: Sequence[Path]) -> Path:
    """Back up only the MCP configuration files this command will change."""
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    backup_dir = MCP_BACKUP_ROOT / stamp
    suffix = 1
    while backup_dir.exists():
        backup_dir = MCP_BACKUP_ROOT / f"{stamp}-{suffix}"
        suffix += 1
    backup_dir.mkdir(parents=True)
    manifest = []
    for index, path in enumerate(paths, 1):
        backup_name = f"{index}-{path.name}"
        shutil.copy2(path, backup_dir / backup_name)
        manifest.append(f"{backup_name}\t{path}")
    (backup_dir / "manifest.tsv").write_text("\n".join(manifest) + "\n")
    return backup_dir


# --------------------------------------------------------------------------
# AWS MCP profile allowlists
# --------------------------------------------------------------------------


class McpConfig:
    def __init__(self, agent: str, path: Path, kind: str, profiles: List[str]):
        self.agent = agent
        self.path = path
        self.kind = kind
        self.profiles = profiles


def mcp_config_locations() -> List[Tuple[str, Path, str]]:
    claude_root = Path(os.environ.get("CLAUDE_CONFIG_DIR", str(Path.home())))
    codex_root = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))
    return [
        ("Cursor", Path.home() / ".cursor" / "mcp.json", "json"),
        ("Claude Code", claude_root / ".claude.json", "json"),
        ("Gemini CLI", Path.home() / ".gemini" / "settings.json", "json"),
        ("Kiro", Path.home() / ".kiro" / "settings" / "mcp.json", "json"),
        ("Codex", codex_root / "config.toml", "toml"),
    ]


def split_mcp_profiles(raw: object, path: Path) -> List[str]:
    if raw is None:
        return []
    if not isinstance(raw, str):
        raise GssoError(f"{MCP_ENV_KEY} is not a string in {path}")
    profiles = raw.split()
    for profile in profiles:
        validate_mcp_profile_name(profile)
    return profiles


def validate_mcp_profile_name(profile: str) -> None:
    if not MCP_PROFILE_RE.match(profile):
        raise GssoError(
            f"unsupported MCP profile name: {profile!r}",
            fix="use a profile name without whitespace, quotes, or backslashes",
        )


def strip_trailing_commas(text: str) -> str:
    """Drop `,` that sits directly before a `}` or `]`, ignoring strings."""
    out = []
    in_string = False
    escaped = False
    for i, char in enumerate(text):
        if in_string:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
        elif char == '"':
            in_string = True
        elif char == ",":
            rest = text[i + 1 :].lstrip(" \t\r\n")
            if rest[:1] in ("}", "]"):
                continue
        out.append(char)
    return "".join(out)


def load_mcp_json(path: Path) -> object:
    """Parse an agent's MCP config.

    Editors such as Cursor accept a trailing comma, so a hand-edited file that
    the agent itself loads fine is not valid strict JSON.
    """
    try:
        text = path.read_text()
    except OSError as error:
        raise GssoError(f"cannot read MCP JSON {path}: {error}")
    try:
        return json.loads(text)
    except ValueError:
        pass
    try:
        return json.loads(strip_trailing_commas(text))
    except ValueError as error:
        raise GssoError(
            f"cannot parse MCP JSON {path}: {error}",
            fix="comments are not supported; remove them or fix the syntax by hand",
        )


def read_json_mcp_profiles(path: Path) -> Optional[List[str]]:
    data = load_mcp_json(path)
    if not isinstance(data, dict):
        raise GssoError(f"MCP JSON root is not an object: {path}")
    servers = data.get("mcpServers")
    if not isinstance(servers, dict) or "aws-mcp" not in servers:
        return None
    server = servers["aws-mcp"]
    if not isinstance(server, dict):
        raise GssoError(f"mcpServers.aws-mcp is not an object in {path}")
    env = server.get("env")
    if env is None:
        return []
    if not isinstance(env, dict):
        raise GssoError(f"mcpServers.aws-mcp.env is not an object in {path}")
    return split_mcp_profiles(env.get(MCP_ENV_KEY), path)


def toml_section_bounds(
    lines: Sequence[str], header_re: re.Pattern
) -> Optional[Tuple[int, int]]:
    start = next((i for i, line in enumerate(lines) if header_re.match(line)), None)
    if start is None:
        return None
    end = next(
        (i for i in range(start + 1, len(lines)) if TOML_SECTION_RE.match(lines[i])),
        len(lines),
    )
    return start, end


def toml_env_value(line: str) -> Optional[str]:
    match = re.match(
        rf'^\s*{MCP_ENV_KEY}\s*=\s*"([^"]*)"\s*(?:#.*)?$', line
    )
    return match.group(1) if match else None


def read_toml_mcp_profiles(path: Path) -> Optional[List[str]]:
    try:
        lines = path.read_text().splitlines()
    except OSError as error:
        raise GssoError(f"cannot read Codex MCP config {path}: {error}")
    parent = toml_section_bounds(lines, CODEX_MCP_RE)
    if parent is None:
        return None

    env_section = toml_section_bounds(lines, CODEX_MCP_ENV_RE)
    if env_section:
        for line in lines[env_section[0] + 1 : env_section[1]]:
            value = toml_env_value(line)
            if value is not None:
                return split_mcp_profiles(value, path)
        return []

    for line in lines[parent[0] + 1 : parent[1]]:
        if not re.match(r"^\s*env\s*=", line):
            continue
        match = re.search(rf'{MCP_ENV_KEY}\s*=\s*"([^"]*)"', line)
        return split_mcp_profiles(match.group(1), path) if match else []
    return []


def discover_mcp_configs() -> List[McpConfig]:
    configs = []
    for agent, path, kind in mcp_config_locations():
        if not path.is_file():
            continue
        profiles = (
            read_json_mcp_profiles(path)
            if kind == "json"
            else read_toml_mcp_profiles(path)
        )
        if profiles is not None:
            configs.append(McpConfig(agent, path, kind, profiles))
    return configs


def write_json_mcp_profiles(path: Path, profiles: Sequence[str]) -> None:
    data = load_mcp_json(path)
    server = data["mcpServers"]["aws-mcp"]
    env = server.setdefault("env", {})
    if not isinstance(env, dict):
        raise GssoError(f"mcpServers.aws-mcp.env is not an object in {path}")
    env[MCP_ENV_KEY] = " ".join(profiles)
    atomic_write(path, json.dumps(data, indent=2) + "\n")


def write_toml_mcp_profiles(path: Path, profiles: Sequence[str]) -> None:
    text = path.read_text()
    lines = text.splitlines(keepends=True)
    value = " ".join(profiles)
    env_section = toml_section_bounds(lines, CODEX_MCP_ENV_RE)
    if env_section:
        for i in range(env_section[0] + 1, env_section[1]):
            if toml_env_value(lines[i].rstrip("\r\n")) is not None:
                newline = "\r\n" if lines[i].endswith("\r\n") else "\n"
                lines[i] = f'{MCP_ENV_KEY} = "{value}"{newline}'
                atomic_write(path, "".join(lines))
                return
        lines.insert(env_section[0] + 1, f'{MCP_ENV_KEY} = "{value}"\n')
        atomic_write(path, "".join(lines))
        return

    parent = toml_section_bounds(lines, CODEX_MCP_RE)
    if parent is None:
        raise GssoError(f"no aws-mcp entry in {path}")
    for i in range(parent[0] + 1, parent[1]):
        if not re.match(r"^\s*env\s*=", lines[i]):
            continue
        if "{" not in lines[i] or "}" not in lines[i]:
            raise GssoError(
                f"unsupported multi-line inline env in {path}",
                fix=f"convert it to [mcp_servers.aws-mcp.env] and re-run",
            )
        if re.search(rf'{MCP_ENV_KEY}\s*=\s*"[^"]*"', lines[i]):
            lines[i] = re.sub(
                rf'{MCP_ENV_KEY}\s*=\s*"[^"]*"',
                f'{MCP_ENV_KEY} = "{value}"',
                lines[i],
                count=1,
            )
        else:
            close = lines[i].rfind("}")
            before = lines[i][:close].rstrip()
            separator = "" if before.endswith("{") else ","
            lines[i] = (
                f'{before}{separator} {MCP_ENV_KEY} = "{value}"'
                f'{lines[i][close:]}'
            )
        atomic_write(path, "".join(lines))
        return

    separator = "" if text.endswith("\n") or not text else "\n"
    addition = (
        f"{separator}\n[mcp_servers.aws-mcp.env]\n"
        f'{MCP_ENV_KEY} = "{value}"\n'
    )
    atomic_write(path, text + addition)


def write_mcp_profiles(config: McpConfig, profiles: Sequence[str]) -> None:
    if config.kind == "json":
        write_json_mcp_profiles(config.path, profiles)
    else:
        write_toml_mcp_profiles(config.path, profiles)


def with_default_first(profiles: Sequence[str], default: Optional[str]) -> List[str]:
    """The proxy uses the first AWS_MCP_PROXY_PROFILES name as the default."""
    names = list(profiles)
    if not default:
        return names
    if default not in names:
        raise GssoError(
            f"{default} is not in the AWS MCP allowlist",
            fix="add it with `gsso mcp add` first",
        )
    return [default] + [name for name in names if name != default]


def current_mcp_profiles(
    configs: Sequence[McpConfig], announce: bool = True
) -> List[str]:
    """Shared allowlist across agents.

    If the lists already match, that list is used. If they drifted (for
    example Codex was edited by hand), gsso truncates to the intersection so
    it never invents a profile that is missing from some agent. Order and the
    default come from the shortest list. An empty intersection means there is
    no shared current set; `gsso mcp add PROFILE` can then write a new one.
    """
    if not configs:
        return []
    distinct = {tuple(config.profiles) for config in configs}
    if len(distinct) <= 1:
        return list(next(iter(distinct), ()))

    shortest = min(configs, key=lambda config: (len(config.profiles), config.agent))
    shared_names = set(shortest.profiles)
    for config in configs:
        shared_names &= set(config.profiles)
    shared = [name for name in shortest.profiles if name in shared_names]
    detail = "; ".join(
        f"{config.agent}={','.join(config.profiles) or '(empty)'}"
        for config in configs
    )
    if announce:
        dropped = sorted(
            {name for config in configs for name in config.profiles} - set(shared)
        )
        extra = f"; dropping {', '.join(dropped)}" if dropped else ""
        if shared:
            err(
                "AWS MCP allowlists differ across agents; "
                f"truncating to the {len(shared)} shared profile"
                f"{'' if len(shared) == 1 else 's'}{extra}"
            )
        else:
            err(
                "AWS MCP allowlists differ across agents and share no profiles; "
                "treating the current allowlist as empty"
            )
        err(f"  {detail}")
    return shared


