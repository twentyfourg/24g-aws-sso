def require_tty(what: str) -> None:
    if not sys.stdin.isatty():
        raise GssoError(
            f"{what} needs an interactive terminal",
            EX_TTY,
            "pass the names as arguments instead",
        )


def supports_checkbox_menu() -> bool:
    return (
        sys.stdin.isatty()
        and sys.stderr.isatty()
        and os.environ.get("TERM", "") not in ("", "dumb")
        and os.name == "posix"
    )


def read_menu_key(fd: int) -> str:
    """Read one key from a POSIX terminal in raw mode."""
    import select

    first = os.read(fd, 1)
    if first in (b"\r", b"\n"):
        return "enter"
    if first == b" ":
        return "space"
    if first == b"/":
        return "search"
    if first in (b"\x7f", b"\x08"):
        return "backspace"
    if first in (b"d", b"D"):
        return "default"
    if first in (b"q", b"Q"):
        return "quit"
    if first == b"\x03":
        return "interrupt"
    if first == b"\x1b":
        if not select.select([fd], [], [], 0.05)[0]:
            return "escape"
        rest = os.read(fd, 2)
        if rest == b"[A":
            return "up"
        if rest == b"[B":
            return "down"
    if first.isascii() and first.decode(errors="ignore").isprintable():
        return f"char:{first.decode()}"
    return "other"


def choose_checkboxes(
    options: Sequence[str],
    prompt: str,
    allow_default: bool = False,
    preselected: Sequence[str] = (),
    default_option: Optional[str] = None,
) -> Tuple[List[str], Optional[str]]:
    """Interactive dependency-free checkbox menu for macOS and Linux."""
    import termios
    import tty

    fd = sys.stdin.fileno()
    previous = termios.tcgetattr(fd)
    checked = set(preselected)
    selected: List[int] = [i for i, name in enumerate(options) if name in checked]
    default: Optional[int] = (
        options.index(default_option)
        if allow_default and default_option in options
        else None
    )
    current = selected[0] if selected else 0
    query = ""
    searching = False
    offset = 0
    height = max(1, shutil.get_terminal_size().lines - 7)
    try:
        tty.setraw(fd)
        sys.stderr.write("\x1b[?1049h\x1b[?25l")
        while True:
            visible = [
                index
                for index, name in enumerate(options)
                if query.lower() in name.lower()
            ]
            if visible:
                current = min(current, len(visible) - 1)
            else:
                current = 0
            if current < offset:
                offset = current
            elif current >= offset + height:
                offset = current - height + 1

            sys.stderr.write("\x1b[H\x1b[2J")
            sys.stderr.write(f"{prompt}\r\n")
            help_line = (
                "Up/Down: move   Space: toggle   /: search   "
                "Enter: confirm   Esc/Q: cancel"
            )
            if allow_default:
                help_line += "   D: set default"
            sys.stderr.write(f"{help_line}\r\n")
            if query or searching:
                search_cursor = "_" if searching else ""
                sys.stderr.write(
                    f"Search: {query}{search_cursor} "
                    f"({len(visible)} matches; Enter finishes, Esc clears)\r\n"
                )
            else:
                sys.stderr.write("\r\n")
            for position in range(offset, min(offset + height, len(visible))):
                index = visible[position]
                cursor = ">" if position == current else " "
                mark = "x" if index in selected else " "
                label = options[index]
                if allow_default and index == default:
                    label += "  (default)"
                sys.stderr.write(f"{cursor} [{mark}] {label}\r\n")
            if not visible:
                sys.stderr.write("  No matching profiles\r\n")
            elif len(visible) > height:
                sys.stderr.write(
                    f"\r\nShowing {offset + 1}-"
                    f"{min(offset + height, len(visible))} of {len(visible)}\r\n"
                )
            sys.stderr.flush()

            key = read_menu_key(fd)
            if searching:
                if key == "enter":
                    searching = False
                elif key == "escape":
                    searching = False
                    query = ""
                    current = 0
                    offset = 0
                elif key == "backspace":
                    query = query[:-1]
                    current = 0
                    offset = 0
                elif key == "space":
                    query += " "
                    current = 0
                    offset = 0
                elif key == "default":
                    query += "d"
                    current = 0
                    offset = 0
                elif key == "quit":
                    query += "q"
                    current = 0
                    offset = 0
                elif key == "search":
                    query += "/"
                    current = 0
                    offset = 0
                elif key.startswith("char:"):
                    query += key[5:]
                    current = 0
                    offset = 0
                elif key == "interrupt":
                    raise GssoError("selection cancelled")
                continue

            if key == "up":
                if visible:
                    current = (current - 1) % len(visible)
            elif key == "down":
                if visible:
                    current = (current + 1) % len(visible)
            elif key == "search":
                searching = True
                query = ""
                current = 0
                offset = 0
            elif key == "space" and visible:
                index = visible[current]
                if index in selected:
                    selected.remove(index)
                    if default == index:
                        default = None
                else:
                    selected.append(index)
            elif key == "default" and allow_default and visible:
                index = visible[current]
                if index not in selected:
                    selected.append(index)
                default = index
            elif key == "enter":
                if not selected:
                    continue
                names = [options[index] for index in selected]
                chosen = options[default] if default is not None else None
                return names, chosen
            elif key == "escape" and query:
                query = ""
                current = 0
                offset = 0
            elif key in ("escape", "quit", "interrupt"):
                raise GssoError("selection cancelled")
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, previous)
        sys.stderr.write("\x1b[?25h\x1b[?1049l")
        sys.stderr.flush()


def choose_one(options: Sequence[str], prompt: str, initial: int = 0) -> str:
    """Interactive single-select list for macOS and Linux."""
    import termios
    import tty

    fd = sys.stdin.fileno()
    previous = termios.tcgetattr(fd)
    current = initial if 0 <= initial < len(options) else 0
    offset = 0
    height = max(1, min(len(options), shutil.get_terminal_size().lines - 5))
    try:
        tty.setraw(fd)
        sys.stderr.write("\x1b[?1049h\x1b[?25l")
        while True:
            if current < offset:
                offset = current
            elif current >= offset + height:
                offset = current - height + 1

            sys.stderr.write("\x1b[H\x1b[2J")
            sys.stderr.write(f"{prompt}\r\n")
            sys.stderr.write(
                "Up/Down: move   Enter: set default   Esc/Q: cancel\r\n\r\n"
            )
            for index in range(offset, min(offset + height, len(options))):
                cursor = ">" if index == current else " "
                mark = "*" if index == current else " "
                sys.stderr.write(f"{cursor} ({mark}) {options[index]}\r\n")
            if len(options) > height:
                sys.stderr.write(
                    f"\r\nShowing {offset + 1}-"
                    f"{min(offset + height, len(options))} of {len(options)}\r\n"
                )
            sys.stderr.flush()

            key = read_menu_key(fd)
            if key == "up":
                current = (current - 1) % len(options)
            elif key == "down":
                current = (current + 1) % len(options)
            elif key == "enter":
                return options[current]
            elif key in ("escape", "quit", "interrupt"):
                raise GssoError("selection cancelled")
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, previous)
        sys.stderr.write("\x1b[?25h\x1b[?1049l")
        sys.stderr.flush()


def choose(
    options: Sequence[str],
    prompt: str,
    multiple: bool,
    allow_default: bool = False,
    preselected: Sequence[str] = (),
    default_option: Optional[str] = None,
) -> Tuple[List[str], Optional[str]]:
    require_tty(prompt)
    if multiple and supports_checkbox_menu():
        return choose_checkboxes(
            options,
            prompt,
            allow_default=allow_default,
            preselected=preselected,
            default_option=default_option,
        )
    if not multiple and supports_checkbox_menu():
        return [choose_one(options, prompt)], None
    checked = set(preselected)
    for i, option in enumerate(options, 1):
        mark = "x" if option in checked else " "
        suffix = "  (default)" if allow_default and option == default_option else ""
        err(f"  {i:>3}. [{mark}] {option}{suffix}")
    err("")
    raw = (
        input(f"{prompt}: ")
        if not multiple
        else input(
            f"{prompt} (numbers or ranges"
            f"{', dN for default' if allow_default else ''}, comma separated): "
        )
    )
    indexes = []
    default_index = None
    for token in raw.replace(" ", ",").split(","):
        if not token:
            continue
        if "-" in token:
            start, separator, end = token.partition("-")
            if (
                not separator
                or not start.isdigit()
                or not end.isdigit()
                or int(start) > int(end)
            ):
                raise GssoError(f"not a valid choice or range: {token}")
            indexes.extend(range(int(start), int(end) + 1))
        elif token.isdigit():
            indexes.append(int(token))
        elif allow_default and token[:1].lower() == "d" and token[1:].isdigit():
            indexes.append(int(token[1:]))
            default_index = int(token[1:])
        else:
            raise GssoError(f"not a valid choice: {token}")
    if any(index < 1 or index > len(options) for index in indexes):
        raise GssoError("a choice is outside the displayed range")
    picks = []
    for index in indexes:
        option = options[index - 1]
        if option not in picks:
            picks.append(option)
    if not picks:
        raise GssoError("nothing selected")
    names = picks if multiple else picks[:1]
    chosen_default = (
        options[default_index - 1] if allow_default and default_index is not None else None
    )
    return names, chosen_default


def confirm(question: str) -> bool:
    if not sys.stdin.isatty():
        raise GssoError(
            "this needs confirmation but there is no terminal",
            EX_TTY,
            "re-run from an interactive shell",
        )
    return input(f"{question} [y/N]: ").strip().lower() in ("y", "yes")


