class Profile:
    def __init__(
        self,
        name: str,
        account_id: Optional[str] = None,
        account_name: Optional[str] = None,
        role_name: Optional[str] = None,
        managed: bool = False,
    ):
        self.name = name
        self.account_id = account_id
        self.account_name = account_name
        self.role_name = role_name
        self.managed = managed


def read_config_profiles() -> List[Profile]:
    config = ConfigFile(CONFIG_PATH)
    profiles = []
    for block in config.sections():
        if not block.header.startswith("profile "):
            continue
        profiles.append(
            Profile(
                name=block.header[len("profile ") :].strip(),
                account_id=block.get("sso_account_id"),
                account_name=block.comment_value(ACCOUNT_NAME_KEY),
                role_name=block.get("sso_role_name"),
                managed=block.has_comment(MANAGED_MARKER),
            )
        )
    return profiles


def read_credentials_profile_names() -> List[str]:
    """Section headers only. Values in this file are never read."""
    if not CREDENTIALS_PATH.exists():
        return []
    names = []
    for line in CREDENTIALS_PATH.read_text().splitlines():
        match = SECTION_RE.match(line)
        if match:
            names.append(match.group(1).strip())
    return names


def sanitize(part: str) -> str:
    part = re.sub(r"\s+", "-", part.strip())
    part = re.sub(r"[^A-Za-z0-9._-]", "", part)
    return re.sub(r"-{2,}", "-", part).strip("-")


def proposed_name(account_name: str, role_name: str, shared_roles: set) -> str:
    """System roles and roles present in several accounts get an account prefix."""
    account = sanitize(account_name)
    role = sanitize(role_name)
    if SYSTEM_ROLE_RE.match(role) or role_name in shared_roles:
        return f"{account}-{role}"
    return role


def validate_profile_name(name: str) -> None:
    if not PROFILE_NAME_RE.fullmatch(name):
        raise GssoError(
            f"unsupported AWS profile name: {name!r}",
            fix="use letters, numbers, periods, underscores, and hyphens",
        )


def prompt_profile_name(label: str, default: str, occupied: set) -> str:
    """Prompt until a valid, unused profile name is supplied."""
    while True:
        name = input(f"Profile name for {label} [{default}]: ").strip() or default
        try:
            validate_profile_name(name)
        except GssoError as error:
            err(f"gsso: {error}")
            if error.fix:
                err(f"  fix: {error.fix}")
            continue
        if name in occupied:
            err(f"gsso: profile already exists: {name}")
            continue
        return name


def shared_role_names(pairs: Sequence[Tuple[str, str, str]]) -> set:
    counts: Dict[str, set] = {}
    for account_id, _account_name, role_name in pairs:
        counts.setdefault(role_name, set()).add(account_id)
    return {role for role, accounts in counts.items() if len(accounts) > 1}


def fetch_account_roles(token: str, account_id: str) -> List[dict]:
    """List roles in one account. Retry on the Identity Center read throttle."""
    delay = 0.5
    last: Optional[GssoError] = None
    for _ in range(ROLE_FETCH_RETRIES):
        try:
            data = json.loads(
                run_aws(
                    [
                        "sso",
                        "list-account-roles",
                        "--access-token",
                        token,
                        "--region",
                        SSO_REGION,
                        "--account-id",
                        account_id,
                    ],
                    secret=token,
                )
            )
            return data.get("roleList", [])
        except GssoError as error:
            last = error
            if "TooManyRequests" not in str(error):
                raise
            time.sleep(delay)
            delay *= 2
    assert last is not None
    raise last


def fetch_remote_pairs(token: str) -> List[Tuple[str, str, str]]:
    """Return (account_id, account_name, role_name) for everything the user has."""
    accounts = json.loads(
        run_aws(
            ["sso", "list-accounts", "--access-token", token, "--region", SSO_REGION],
            secret=token,
        )
    ).get("accountList", [])
    if not accounts:
        return []
    workers = min(ROLE_FETCH_CONCURRENCY, len(accounts))
    err(f"Listing roles in {len(accounts)} accounts ({workers} at a time)")
    pairs: List[Tuple[str, str, str]] = []
    with ThreadPoolExecutor(max_workers=workers) as pool:
        pending = {
            pool.submit(fetch_account_roles, token, account["accountId"]): account
            for account in accounts
        }
        for future in as_completed(pending):
            account = pending[future]
            account_id = account["accountId"]
            account_name = account.get("accountName") or account_id
            for role in future.result():
                pairs.append((account_id, account_name, role["roleName"]))
    return pairs


def read_portal_cache() -> Optional[Tuple[str, List[Tuple[str, str, str]]]]:
    """Return (fetchedAt, pairs) or None if the cache is missing or unusable.

    The file stores account and role names only. Never a token.
    """
    if not PORTAL_CACHE_PATH.exists():
        return None
    try:
        data = json.loads(PORTAL_CACHE_PATH.read_text())
    except (ValueError, OSError):
        return None
    if data.get("startUrl") != SSO_START_URL:
        return None
    raw = data.get("pairs")
    if not isinstance(raw, list):
        return None
    pairs = []
    for item in raw:
        if not isinstance(item, dict):
            return None
        account_id = item.get("accountId")
        account_name = item.get("accountName")
        role_name = item.get("roleName")
        if not account_id or not account_name or not role_name:
            return None
        pairs.append((account_id, account_name, role_name))
    fetched = str(data.get("fetchedAt") or "unknown")
    return fetched, pairs


def write_portal_cache(pairs: Sequence[Tuple[str, str, str]]) -> None:
    payload = {
        "startUrl": SSO_START_URL,
        "fetchedAt": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "pairs": [
            {"accountId": account_id, "accountName": account_name, "roleName": role_name}
            for account_id, account_name, role_name in sorted(pairs)
        ],
    }
    PORTAL_CACHE_PATH.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(PORTAL_CACHE_PATH, json.dumps(payload, indent=2) + "\n")


def load_remote_pairs(hard_refresh: bool) -> List[Tuple[str, str, str]]:
    """Portal account/role matrix: cache by default, Identity Center on miss or --hard-refresh."""
    if not hard_refresh:
        cached = read_portal_cache()
        if cached is not None:
            fetched, pairs = cached
            err(
                f"Using portal cache from {fetched} "
                f"({len(pairs)} roles). Refresh with --hard-refresh."
            )
            return pairs
    token = load_access_token()
    pairs = fetch_remote_pairs(token)
    write_portal_cache(pairs)
    err(f"Wrote {PORTAL_CACHE_PATH}")
    return pairs


def profile_section_lines(
    name: str, account_id: str, account_name: str, role_name: str, region: str
) -> List[str]:
    return [
        f"[profile {name}]\n",
        f"{MANAGED_MARKER}\n",
        f"{ACCOUNT_NAME_KEY} {account_name}\n",
        f"sso_session = {SESSION_NAME}\n",
        f"sso_account_id = {account_id}\n",
        f"sso_role_name = {role_name}\n",
        f"region = {region}\n",
        "output = json\n",
    ]


def write_profiles(
    entries: Sequence[Tuple[str, str, str, str]], region: str
) -> None:
    """Append every profile in one parse and one atomic write.

    `aws configure set` rewrites the whole file per key, so writing n profiles
    through it costs 5n CLI launches and 5n rewrites of ~/.aws/config.
    """
    if not entries:
        return
    config = ConfigFile(CONFIG_PATH)
    for name, account_id, account_name, role_name in entries:
        if config.section(f"profile {name}") is not None:
            raise GssoError(f"profile already exists: {name}")
        config.append_section(
            profile_section_lines(name, account_id, account_name, role_name, region)
        )
    config.save()


def default_region() -> str:
    block = ConfigFile(CONFIG_PATH).section("default")
    return (block.get("region") if block else None) or DEFAULT_REGION


